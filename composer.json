    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "authors": [
        {
            "name": "RenzoMedina",
            "email": "medinast30@gmail.com"
        }
    ],
    "require-dev": {
        "marcocesarato/php-conventional-changelog": "^1.17",
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "changelog": "conventional-changelog",
        "first-release": "conventional-changelog --first-release --annotate-tag",
